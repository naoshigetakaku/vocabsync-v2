/* --- The import ----------------------------------------------------------- */

/** Creates the folder if it is not there, whatever case its name is in. */
function ensureFolder_(name) {
  var folders = listFolders_();
  for (var i = 0; i < folders.length; i++) {
    if (folders[i].name.toLowerCase() === name.toLowerCase()) return folders[i];
  }
  var created = createFolder_(name);
  Logger.log('Created folder "%s".', name);
  return created;
}

/** Key for "this word is already in this folder". */
function wordKey_(folder, word) {
  return folder.toLowerCase() + '\n' + word.toLowerCase();
}

function addALevelWords() {
  var sheet = getSheet_();
  var schema = ensureHeaders_(sheet);
  var width = schema.width;

  var chem = ensureFolder_(CHEM_FOLDER);
  var math = ensureFolder_(MATH_FOLDER);

  // What is already there, so a second run adds nothing twice.
  var seen = {};
  var existing = listWords_();
  for (var e = 0; e < existing.length; e++) {
    seen[wordKey_(existing[e].folder || '', existing[e].word)] = true;
  }

  var now = new Date().toISOString();
  var rows = [];
  var counts = {};
  var skipped = 0;

  var batches = [[chem.name, CHEM_WORDS], [math.name, MATH_WORDS]];
  for (var b = 0; b < batches.length; b++) {
    var folder = batches[b][0];
    var list = batches[b][1];

    for (var i = 0; i < list.length; i++) {
      var entry = list[i];
      if (seen[wordKey_(folder, entry[0])]) {
        skipped += 1;
        continue;
      }
      seen[wordKey_(folder, entry[0])] = true;

      // Straight through the same validation every saved word goes through,
      // so a typo here fails now rather than on the device later.
      var fields = validate_({
        word: entry[0], pos: entry[1], definition: entry[2], note: entry[3],
        color: 'default', folder: folder, status: ''
      });
      rows.push(wordToRow_(buildRecord_(fields, Utilities.getUuid(), now, now), schema.map, width));
      counts[folder] = (counts[folder] || 0) + 1;
    }
  }

  // One write for the lot: appendRow per word would be hundreds of calls.
  if (rows.length) {
    sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, width).setValues(rows);
  }

  Logger.log('Added %s word(s): %s in "%s", %s in "%s".',
    rows.length, counts[chem.name] || 0, chem.name, counts[math.name] || 0, math.name);
  if (skipped) Logger.log('Skipped %s word(s) already in those folders.', skipped);
  Logger.log('Done. The app picks these up on its next sync.');
}
